```mermaid
flowchart LR
    subgraph HW["🔧 Camada de Hardware"]
        ESP["ESP32 + Sensores"]
        S1["🌡️ Temperatura"]
        S2["💧 Umidade"]
        S3["⛰️ Altitude"]
        S4["🌪️ Pressão Atm."]
        ESP --> S1 & S2 & S3 & S4
    end

    subgraph FB["☁️ Firebase Cloud"]
        RTDB["Realtime Database\n/lavouras/{id}/estado_atual\n/lavouras/{id}/historico"]
        HOST["Firebase Hosting\nSPA (index.html)"]
    end

    subgraph WEB["🖥️ Dashboard Web"]
        MAIN["main.js\nPonto de entrada"]
        MON["monitoramento.js\nonValue() listener"]
        GRAF["grafico.js\nChart.js"]
        INT["interface.js\nAtualização DOM"]
        MAIN --> MON & GRAF
        MON --> INT
    end

    ESP -- "Escreve dados (RTDB)" --> RTDB
    RTDB -- "onValue() — WebSocket" --> MON
    GRAF -- "get() — leitura única" --> RTDB
    HOST -- "Serve" --> WEB
```

